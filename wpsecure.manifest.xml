<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="MailApp">
  <Id>05D3652c-2c16-4e8e-a8f0-1d9f4a6b8893</Id>
  <Version>84.19.7.4</Version>
  <ProviderName>OSD365 Limited</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Insert Signature"/>
  <Description DefaultValue="Insert WPSecure cloud signature for Outlook."/>
  <IconUrl DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://wpsecure.shop/documentation"/>
  <AppDomains>
    <AppDomain>https://your-web-app-url-domain.azurewebsites.net</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.14"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://your-web-app-url-domain.azurewebsites.net/wpsecure.html"/>
        <RequestedHeight>40</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="Commands.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
			<ExtensionPoint xsi:type="MobileMessageComposeCommandSurface">
			  <Group id="MobileGroup">
				<Label resid="GroupLabel" />
				<Control xsi:type="MobileButton" id="MobileInsertSignatureButton">
				  <Label resid="ActionButton.Label" />
					<Icon>
					  <!-- 25px base (iOS/Android), 1x/2x/3x -->
					  <bt:Image size="25" scale="1" resid="Icon.25x25.scale-100" />
					  <bt:Image size="25" scale="2" resid="Icon.25x25.scale-200" />
					  <bt:Image size="25" scale="3" resid="Icon.25x25.scale-300" />
					  <!-- 32px base, 1x/2x/3x -->
					  <bt:Image size="32" scale="1" resid="Icon.32x32.scale-100" />
					  <bt:Image size="32" scale="2" resid="Icon.32x32.scale-200" />
					  <bt:Image size="32" scale="3" resid="Icon.32x32.scale-300" />
					  <!-- 48px base, 1x/2x/3x -->
					  <bt:Image size="48" scale="1" resid="Icon.48x48.scale-100" />
					  <bt:Image size="48" scale="2" resid="Icon.48x48.scale-200" />
					  <bt:Image size="48" scale="3" resid="Icon.48x48.scale-300" />
					</Icon>
				  <Action xsi:type="ExecuteFunction">
					<FunctionName>WPSecure_Reinsert</FunctionName>
				  </Action>
				</Control>
			  </Group>
			</ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="MessageComposeCommandGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="messageActionButton">
                    <Label resid="ActionButton.Label"/>
                    <Supertip>
                      <Title resid="ActionButton.Label"/>
                      <Description resid="ActionButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>WPSecure_Reinsert</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="AppointmentOrganizerCommandGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="appointmentActionButton">
                    <Label resid="ActionButton.Label"/>
                    <Supertip>
                      <Title resid="ActionButton.Label"/>
                      <Description resid="ActionButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>WPSecure_Reinsert</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="WPSecure_OnMessageCompose"/>
              </LaunchEvents>
              <SourceLocation resid="Commands.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
			<bt:Image id="Icon.16x16" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-16.png"/>
			<bt:Image id="Icon.32x32" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-32.png"/>
			<bt:Image id="Icon.80x80" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-80.png"/>
			<bt:Image id="Icon.25x25.scale-100" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-25.png"/>
			<bt:Image id="Icon.25x25.scale-200" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-50.png"/>
			<bt:Image id="Icon.25x25.scale-300" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-75.png"/>
			<bt:Image id="Icon.32x32.scale-100" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-32.png"/>
			<bt:Image id="Icon.32x32.scale-200" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-64.png"/>
			<bt:Image id="Icon.32x32.scale-300" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-96.png"/>
			<bt:Image id="Icon.48x48.scale-100" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-48.png"/>
			<bt:Image id="Icon.48x48.scale-200" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-96.png"/>
			<bt:Image id="Icon.48x48.scale-300" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/assets/icon-128.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/wpsecure.js"/>
          <bt:Url id="Commands.Url" DefaultValue="https://your-web-app-url-domain.azurewebsites.net/wpsecure.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Insert Signature"/>
          <bt:String id="ActionButton.Label" DefaultValue="Insert Signature"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ActionButton.Tooltip" DefaultValue="Insert WPSecure cloud signature for Outlook."/>
        </bt:LongStrings>
      </Resources>
      <WebApplicationInfo>
        <Id>f8de811a-1855-4ad7-b507-0015d6d67a8b</Id>
        <Resource>api://your-web-app-url-domain.azurewebsites.net/f8de811a-1855-4ad7-b507-0015d6d67a8b</Resource>
        <Scopes>
          <Scope>openid</Scope>
          <Scope>profile</Scope>
        </Scopes>
      </WebApplicationInfo>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>